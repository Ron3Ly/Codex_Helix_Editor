# Copy to deploy/.env. Values below are examples, not discovered settings.
# Use a DNS hostname that resolves to this VM from your Windows computer.
HELIX_DOMAIN=helix.home.arpa

# 0.0.0.0 listens on all VM IPv4 interfaces. You may use the VM's actual LAN IP.
HELIX_BIND_IP=0.0.0.0
HELIX_WORKER_ID=helix-floor-windows

# Leave unset until you choose a real destination in HX Edit.
# Setlist is 1..8. Slot is 01A..32D. Name is an optional human-readable label.
# The server can inspect/build presets without these; staging needs a target.
HELIX_TARGET_SETLIST=
HELIX_TARGET_SLOT=
HELIX_TARGET_SETLIST_NAME=

# An empty list rejects requests carrying an Origin header.
# Native Codex/worker clients normally do not need browser origins.
# If needed, list exact trusted origins separated by commas, never '*'.
HELIX_ALLOWED_ORIGINS=

# Pin these to a release tag or image digest for a repeatable deployment.
HELIX_IMAGE=helix-mcp:local
CADDY_IMAGE=caddy:2-alpine
