{
	# The default deployment is private HTTPS on port 443 only.
	auto_https disable_redirects
	skip_install_trust
}

{$HELIX_DOMAIN} {
	tls internal

	@api path /mcp /mcp/* /worker/* /healthz
	handle @api {
		reverse_proxy app:8080 {
			flush_interval -1
		}
	}

	handle {
		respond "Not found" 404
	}
}
